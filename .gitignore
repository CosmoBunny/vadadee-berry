# Rust
/target/

# Audio test files
*.mp3

# Android / Gradle app directory and build artifacts
/app/
.gradle/
build/
local.properties
*.apk
*.aab

# CI-staged mobile outputs (regenerated every run; ExportOptions.plist is
# generated from signing secrets and must never be committed)
android-artifacts/
android-release/
ios-artifacts/
ios/ExportOptions.plist

# Native libs copied from Rust builds (regenerated on compile)
app/src/main/jniLibs/**/*.so

# Editor project files (MCP save/load)
*.vadadee-berry.json

# Scripts directory
/scripts/

# Distribution artifacts
/dist/

# Desktop download drop (archives only; keep README/.gitkeep)
/release/*
!/release/README.md
!/release/.gitkeep

# Local agent/session caches & scratch
.cache/
scratch/
.deps/
*.deb

# Explicit (non-root) for tools that match bare names
target/

# Local Grok folder
.grok/
